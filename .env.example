# =============================================================================
# Blitz ASR — Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
#
# Most defaults work out-of-the-box for g6.xlarge (NVIDIA L4, 24GB VRAM).
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# HuggingFace Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Required only if downloading gated models (e.g., some NeMo models)
# Get your token at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# Model Configuration (3-Tier Routing)
# ─────────────────────────────────────────────────────────────────────────────
# Tier 1: Fastest — English only
TIER1_MODEL=nvidia/parakeet-tdt_ctc-110m
TIER1_PRECISION=fp16
TIER1_LANGUAGES=en

# Tier 2: Fast Multilingual — 24 European languages
TIER2_MODEL=nvidia/parakeet-tdt-0.6b-v3
TIER2_PRECISION=bfloat16
TIER2_BACKEND=nemo

# Tier 3: Catch-all — 100+ languages (Whisper)
TIER3_MODEL=openai/whisper-large-v3-turbo

# ─────────────────────────────────────────────────────────────────────────────
# Model Supply Chain Pinning (Recommended for Production)
# ─────────────────────────────────────────────────────────────────────────────
# Pin to specific HuggingFace commit SHAs to prevent supply chain attacks.
# Leave empty to use latest (acceptable for dev, NOT recommended for prod).
# TIER1_MODEL_REVISION=abc123def456
# TIER2_MODEL_REVISION=abc123def456
# TIER3_MODEL_REVISION=abc123def456
# WHISPER_TINY_REVISION=abc123def456
# VOXLINGUA_REVISION=abc123def456

# ─────────────────────────────────────────────────────────────────────────────
# Language Detection
# ─────────────────────────────────────────────────────────────────────────────
# Primary: "whisper" (GPU, more accurate) or "voxlingua" (CPU, frees GPU)
PRIMARY_LANGUAGE_DETECTOR=whisper
SECONDARY_LANGUAGE_DETECTOR=voxlingua

# Detection model: "large-v3-turbo" (accurate, already loaded) or "tiny" (saves 8GB)
LANGUAGE_DETECTION_MODEL=large-v3-turbo

# Confidence thresholds
WHISPER_CONFIDENCE_THRESHOLD=0.70
VOXLINGUA_CONFIDENCE_THRESHOLD=0.90

# ─────────────────────────────────────────────────────────────────────────────
# Performance Tuning
# ─────────────────────────────────────────────────────────────────────────────
# Micro-batching (groups concurrent requests for better GPU utilization)
MAX_BATCH_SIZE=4
BATCH_TIMEOUT_MS=15.0
BATCH_CLEANUP_FREQUENCY=1

# Audio processing thresholds
SHORT_AUDIO_THRESHOLD_SEC=300
LOCAL_ATTENTION_THRESHOLD_SEC=1440

# ─────────────────────────────────────────────────────────────────────────────
# Security (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# Authentication is ENABLED by default. To explicitly disable (dev only):
# BLITZ_AUTH_ENABLED=false

# API keys (JSON format). Generate with: python3 -c "import secrets; print(f'blitz_{secrets.token_urlsafe(32)}')"
# Or use AWS Secrets Manager by setting API_KEYS_SECRET_ARN instead.
# API_KEYS={"client1":["blitz_your_key_here"]}

# Rate limiting (requests per minute per client)
# RATE_LIMIT_RPM=60

# ─────────────────────────────────────────────────────────────────────────────
# GPU Memory Management
# ─────────────────────────────────────────────────────────────────────────────
# Reduce CUDA memory fragmentation
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Disable Flash Attention for broader GPU compatibility
HF_USE_FLASH_ATTENTION=0

# ─────────────────────────────────────────────────────────────────────────────
# Observability Stack (Grafana / Prometheus) — only used with
# observability/docker-compose.observability.yml
# ─────────────────────────────────────────────────────────────────────────────
# Grafana admin credentials. GRAFANA_ADMIN_PASSWORD is REQUIRED to start the
# observability stack (no default is shipped). Generate a strong value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
