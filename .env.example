# =============================================================================
# Blitz ASR Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# Every variable shown is also the DEFAULT baked into Dockerfile/blitz/config.py,
# so the file doubles as a complete reference. Uncomment/change only what you
# need to override.
# See Dockerfile and docs/ARCHITECTURE.md for detailed explanations.

# =============================================================================
# Model Selection (must match across Dockerfile + config.py)
# =============================================================================

# Tier 1: Fastest (CTC-110M) - English only by default. Empty disables the tier.
TIER1_MODEL=nvidia/parakeet-tdt_ctc-110m
TIER1_PRECISION=fp16
TIER1_LANGUAGES=en

# Tier 2: Fast multilingual (Parakeet 0.6B) - 24 EU languages
# Supported: bg, hr, cs, da, nl, et, fi, fr, de, el, hu, it, lv, lt, mt,
#            pl, pt, ro, sk, sl, es, sv, ru, uk
TIER2_MODEL=nvidia/parakeet-tdt-0.6b-v3
TIER2_LANGUAGES=bg,hr,cs,da,nl,et,fi,fr,de,el,hu,it,lv,lt,mt,pl,pt,ro,sk,sl,es,sv,ru,uk

# Tier 2 precision: bfloat16 (recommended), fp32 (max accuracy), fp16 (ONNX only)
# Benchmarks: bfloat16=94.5% accuracy/125x RTF, fp32=94.3%/100x, fp16=89.7%/167x
TIER2_PRECISION=bfloat16

# Tier 2 backend: nemo (default, PyTorch) or onnx
TIER2_BACKEND=nemo

# Tier 3: Catch-all (Whisper) for anything outside Tier 1/2
TIER3_MODEL=openai/whisper-large-v3-turbo

# =============================================================================
# Performance Tuning (Optimized for g6.xlarge / L4 24GB)
# =============================================================================

# Micro-batching: wait up to this many ms to gather a batch (0-15ms latency)
BATCH_TIMEOUT_MS=15.0

# Max requests per batch (higher = better GPU util, more memory)
MAX_BATCH_SIZE=4

# Cleanup after every N batches (1 = max stability, higher = faster)
BATCH_CLEANUP_FREQUENCY=1

# Device for inference ('cuda' or 'cpu')
DEVICE=cuda

# =============================================================================
# Long-Form Audio Thresholds
# =============================================================================

# Audio shorter than this uses direct array processing (fastest)
# Recommended: 300s (5 min) covers 80%+ of production use cases
SHORT_AUDIO_THRESHOLD_SEC=300

# Audio longer than this switches to local attention (prevents OOM)
# L4/A10G 24GB: 1440s (24 min), A100 80GB: 3600s (60 min)
LOCAL_ATTENTION_THRESHOLD_SEC=1440

# Chunked transcription when audio exceeds SHORT_AUDIO_THRESHOLD_SEC
# 8 minute chunks prevent OOM on g6.xlarge; 1 second overlap avoids word cutoffs
CHUNK_LENGTH_SEC=480
CHUNK_OVERLAP_SEC=1

# =============================================================================
# Language Detection
# =============================================================================

# Primary detector: "whisper" (GPU, ~150ms, more accurate) or "voxlingua" (CPU)
PRIMARY_LANGUAGE_DETECTOR=whisper

# Secondary detector for fallback when primary confidence is low
SECONDARY_LANGUAGE_DETECTOR=voxlingua

# Confidence thresholds per model
WHISPER_CONFIDENCE_THRESHOLD=0.70
VOXLINGUA_CONFIDENCE_THRESHOLD=0.90

# Whisper model for language detection: "tiny" (saves 8GB) or "large-v3-turbo"
LANGUAGE_DETECTION_MODEL=large-v3-turbo

# [DEPRECATED] Retained for backward compatibility; prefer the two thresholds above
MIN_LANGUAGE_CONFIDENCE=0.70

# =============================================================================
# GPU Memory Management
# =============================================================================

# Reduce CUDA memory fragmentation
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Disable Flash Attention (set to 1 only if your runtime supports it cleanly)
HF_USE_FLASH_ATTENTION=0

# =============================================================================
# ONNX Configuration (Optional - only if TIER2_BACKEND=onnx)
# =============================================================================

# Path to ONNX models.
# - Docker:     /app/models/parakeet (Dockerfile pre-downloads here)
# - Bare metal: ./models/parakeet    (config.py default when running outside Docker)
TIER2_ONNX_MODEL_PATH=/app/models/parakeet

# Auto-download ONNX models from HuggingFace if missing
TIER2_AUTO_DOWNLOAD=true

# =============================================================================
# Cost Estimation (used by /cost endpoint; safe to leave as-is)
# =============================================================================

# Source: AWS Pricing API, Linux/Shared/No Upfront, observed 2026-04-29.
# Refresh with: python scripts/update_pricing.py
INSTANCE_TYPE=g6.xlarge
INSTANCE_REGION=us-east-1
GPU_PRICE_ON_DEMAND=0.8048
GPU_PRICE_SPOT=0.42
GPU_PRICE_SAVINGS_1YR=0.5239
GPU_PRICE_SAVINGS_3YR=0.3694

# =============================================================================
# Batch Mode
# =============================================================================

# Running in AWS Batch mode disables async queues (synchronous processing)
BATCH_MODE=false

# Max accepted /transcribe upload body size (bytes). Default 500 MB.
MAX_UPLOAD_BYTES=524288000

# =============================================================================
# Model Revision Pinning (supply-chain hardening)
# =============================================================================
# Empty = fetch latest from the hub (convenient for dev).
# Set to a commit SHA or tag in production for reproducible, auditable loads.
# See SECURITY.md for rationale.

TIER1_MODEL_REVISION=
TIER2_MODEL_REVISION=
TIER3_MODEL_REVISION=
WHISPER_TINY_REVISION=
VOXLINGUA_REVISION=
SILERO_VAD_REVISION=
